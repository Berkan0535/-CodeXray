# =======================================================
# AI Codebase Analyst — Environment Configuration Template
# =======================================================

# Application
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL with pgvector for Docker, or SQLite for standalone local testing)
DATABASE_URL=sqlite+aiosqlite:///./codebase_analyst.db
SYNC_DATABASE_URL=sqlite:///./codebase_analyst.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://analyst:analyst_secret_password@localhost:5432/codebase_analyst
# SYNC_DATABASE_URL=postgresql://analyst:analyst_secret_password@localhost:5432/codebase_analyst

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_CELERY=false

# AI Provider Configuration: 'mock', 'openai', 'gemini', 'anthropic'
AI_PROVIDER=mock

# OpenAI (Optional when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (Optional when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Resource & Security Limits
MAX_REPO_SIZE_MB=150
MAX_FILE_SIZE_KB=1500
MAX_ANALYSIS_FILES=3000
ANALYSIS_TIMEOUT_SECONDS=300

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
